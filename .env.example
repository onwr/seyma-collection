# ── Veritabanı (import scripti ve uygulama) ───────────────────────────────────
# MariaDB/MySQL bağlantı dizgesi (örnek)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/seyma_collection"

# ── WooCommerce REST API (yalnızca import scripti) ───────────────────────────
# Mağaza kök adresi (https zorunlu). Sonda / olmasın.
WOO_BASE_URL="https://ornek-siteniz.com"
# WooCommerce → Ayarlar → Gelişmiş → REST API ile oluşturulan anahtarlar.
# Bu değerleri asla repoya veya sohbete yapıştırmayın; sadece yerel .env kullanın.
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""

# ── Trendyol Entegrasyon API (Satıcı Paneli → Entegrasyon → API Entegrasyonu) ─
TRENDYOL_SUPPLIER_ID=""
TRENDYOL_API_KEY=""
TRENDYOL_API_SECRET=""
TRENDYOL_COMMISSION_PERCENT="0"
CRON_SECRET=""

# Kullanım (web klasöründen):
#   npx prisma migrate deploy
#   npm run import:woo -- --dry-run --limit=10
#   npm run import:woo
#   npm run import:woo -- --download-images
#
# --dry-run: veritabanına yazmaz, örnek log üretir.
# --limit=N: en fazla N ürün işler.
# --download-images: görselleri public/woo-import/ altına indirir (yavaş, disk kullanır).
